# apps/console — MR-52 A1. Committed on purpose: `.gitignore` keeps `.env*` out but allows
# `.env.example`, and a console nobody can start is a console nobody reviews with.
#
# Copy to `.env.local` (git-ignored) and fill in. Both values are PUBLIC by design: the
# publishable key is inlined into the browser bundle and carries no authority of its own —
# every row it can reach is decided by the signed-in user's JWT and the database's policies.
# The SECRET key must never appear here; it bypasses row-level security entirely.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
