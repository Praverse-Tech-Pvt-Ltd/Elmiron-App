# Elmiron App — environment template
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
# Never commit real keys. Rotate anything that lands in git history.
#
# Local values come from `pnpm db:status` after `pnpm db:start`.
# Remote values come from the Supabase dashboard: Project Settings → API / Database.

# --- Supabase: local stack (default for development) ---
# Values printed by `supabase start`; re-read any time with `pnpm db:status`.
# Local keys are fixed across machines and are not secret, so they are safe here.
# Prefer publishable/secret keys over the legacy JWT anon/service_role pair.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_STUDIO_URL=http://127.0.0.1:54323

# Used by the database tests in services/api. Defaults to the local URL above if unset.
# CI sets this explicitly — see .github/workflows/ci.yml.

# --- Supabase: linked remote project ---
# Used by `supabase link` / `supabase db push`, not by local app code.
#
# The project reference is read from here and from nowhere else. It is never
# hardcoded in a migration, a script or a config file that gets committed.
# The project must be in ap-south-1 (Mumbai). The region cannot be changed later
# without a full migration — confirm it in the dashboard before pushing anything.
SUPABASE_PROJECT_REF=
SUPABASE_REGION=ap-south-1
# Dashboard → Project Settings → Database → Connection string (direct, port 5432).
# If the password contains special characters, percent-encode them.
SUPABASE_REMOTE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Personal access token for the CLI in CI. Dashboard → Account → Access Tokens.
SUPABASE_ACCESS_TOKEN=
