# Elmiron App — environment template
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
# Never commit real keys. Rotate anything that lands in git history.
#
# Local values come from `pnpm db:status` after `pnpm db:start`.
# Remote values come from the Supabase dashboard: Project Settings → API / Database.

# --- Supabase: local stack (default for development) ---
# Values printed by `supabase start`; re-read any time with `pnpm db:status`.
# Local keys are fixed across machines and are not secret, so they are safe here.
# Prefer publishable/secret keys over the legacy JWT anon/service_role pair.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_STUDIO_URL=http://127.0.0.1:54323

# Used by the database tests in services/api. Defaults to the local URL above if unset.
# CI sets this explicitly — see .github/workflows/ci.yml.

# --- Test harness (services/api/tests) ---
# The Gate 0 suite mints its own JWTs and signs fixture users in through GoTrue.
# These are the fixed local-stack values; they are not secrets and are never used
# against a deployed project. Override only if your local stack differs.
# SUPABASE_JWT_SECRET=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Application configuration (packages/core/shared/config.ts) ---
# Nothing single-app is hardcoded in packages/core. A second app — the patient app —
# consumes the same package with different values for every one of these, so they
# are loaded from here and validated at startup. A missing value fails loudly.
APP_JWT_AUDIENCE=authenticated
APP_SITE_URL=http://127.0.0.1:3000
# Comma-separated. Empty is valid for a mobile-only deployment.
APP_ADDITIONAL_REDIRECT_URLS=http://127.0.0.1:3000
# Mobile deep-link scheme, without "://".
APP_DEEP_LINK_SCHEME=elmironmr

# --- Mock API server (services/mock) — interface contract I2 ---
# Frontend builds against this for twelve weeks. `pnpm mock` starts it.
MOCK_PORT=4010

# --- Supabase: linked remote project ---
# Used by `supabase link` / `supabase db push`, not by local app code.
#
# The project reference is read from here and from nowhere else. It is never
# hardcoded in a migration, a script or a config file that gets committed.
# The project must be in ap-south-1 (Mumbai). The region cannot be changed later
# without a full migration — confirm it in the dashboard before pushing anything.
SUPABASE_PROJECT_REF=
SUPABASE_REGION=ap-south-1
# THREE WAYS TO REACH THE REMOTE DATABASE, AND THEY ARE NOT INTERCHANGEABLE.
#
# The dashboard offers the DIRECT string first, which is the one that does not work
# from CI. Getting this wrong produces a network timeout that reads like a bad
# password, so the distinction is written out here rather than left to whoever is
# next in the dashboard.
#
# If the password contains special characters, percent-encode them in all three.

# 1. DIRECT — db.<ref>.supabase.co:5432
#    Supabase serves direct connections over IPv6 only (an IPv4 address is a paid
#    add-on). Fine from a developer machine with IPv6. **Does NOT work from
#    GitHub-hosted runners, which are IPv4-only.**
#    Used by: `supabase link` / `supabase db push` from a laptop.
SUPABASE_REMOTE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# 2. SESSION POOLER — aws-0-<region>.pooler.supabase.com:5432
#    IPv4-reachable, and a real session: prepared statements, advisory locks and
#    `SELECT ... FOR UPDATE SKIP LOCKED` held across statements all behave.
#    **This is the one the scheduled workers need.** Set it as the
#    SUPABASE_DB_URL repository secret used by .github/workflows/retention*.yml.
#    Note the user is `postgres.<ref>`, not `postgres`.
SUPABASE_POOLER_SESSION_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# 3. TRANSACTION POOLER — aws-0-<region>.pooler.supabase.com:6543
#    For short-lived application queries at high concurrency. It recycles the
#    connection between statements, which breaks prepared statements and anything
#    session-scoped. **Never point the retention or reconciliation worker at this**
#    — both hold a claim across statements and would silently lose it.
SUPABASE_POOLER_TRANSACTION_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Personal access token for the CLI in CI. Dashboard → Account → Access Tokens.
SUPABASE_ACCESS_TOKEN=
