{
  "name": "@elmiron/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared types, Zod schemas and API client for the MR app. Interface contract I1.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
